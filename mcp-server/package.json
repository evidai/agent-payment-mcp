{
  "name": "agent-payment-mcp",
  "mcpName": "io.github.evidai/agent-payment",
  "version": "0.10.0",
  "description": "The x402 payment rail for AI agents, as an MCP server. An agent calls any paid HTTP API through LemonCake's gateway with a prepaid, spend-capped Pay Token — no per-call key, custody-free (Stripe Connect Direct Charge). First 3,000 calls free, then 3%. Also ships 8 free real-API demo tools (search / translate / weather / geocode / time / dictionary / fx / echo) that work instantly with zero signup, zero env vars.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-payment-mcp": "./dist/index.js",
    "pay-per-call-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "ai-agent",
    "agent-payment",
    "agent-wallet",
    "pay-per-call",
    "payment",
    "billing",
    "monetization",
    "api-gateway",
    "stripe",
    "autonomous-agent",
    "llm",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evidai/agent-payment-mcp.git"
  },
  "homepage": "https://lemoncake.xyz",
  "bugs": {
    "url": "https://github.com/evidai/agent-payment-mcp/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
