  "main": "dist/index.js",
  "bin": {
    "tokenized-stock-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokenized-stocks",
    "dinari",
    "dshares",
    "usdc",
    "rwa",
    "stablecoin",
    "agentic-trading",
    "ai-agent",
    "spending-cap",
    "guard",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/evidai/lemon-cake.git",
    "directory": "tokenized-stock-mcp"
  },
  "homepage": "https://github.com/evidai/lemon-cake/tree/main/tokenized-stock-mcp",
  "bugs": {
    "url": "https://github.com/evidai/lemon-cake/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dinari/api-sdk": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
