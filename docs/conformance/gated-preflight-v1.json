      "4. effective_budget = min(static_cap, dynamic_limit_usd)",
      "5. evaluated_at <= expires_at (NEW front gate, ~30-60s verdict->charge window)",
      "6. binding.action_ref keys azender1 exactly-once guard (same preimage, action_ref_method named)"
    ],
    "interop": {
      "verifier_side": "haroldmalikfrimpong-ops/agentid ctef-verifier-attestation-v0.1 (same binding_digest construction)",
      "guard_side": "azender1/SafeAgent exactly-once-v1 (action_ref / PENDING->COMMITTED->SKIP)",
      "settlement_side": "lemoncake-reserve-confirm-v1 (this repo)"
    }
  },
