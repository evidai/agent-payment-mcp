# ── Sandbox (default) ─────────────────────────────────────────────
# No keys, no card, no crypto. The demo mints a spend-capped sandbox
# Pay Token and meters calls against the LemonCake sandbox gateway.
LEMONCAKE_SANDBOX_BASE=https://www.lemoncake.xyz
PORT=3000
PRICE_PER_CALL=0.05

# ── Production (Phase 2 — not wired yet) ──────────────────────────
# Charging YOUR own endpoint per call (env-only go-live) is coming in
# Phase 2. For now, to take real payments: register this server's URL
# in LemonCake /app and share the gateway/buy link.
# LEMONCAKE_MODE=production
# LEMONCAKE_SELLER_KEY=
