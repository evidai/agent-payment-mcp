# ── Sandbox (default) ─────────────────────────────────────────────
# No keys, no card, no crypto. With no seller key the server runs in
# sandbox mode, and `npm run demo:agent` mints a spend-capped sandbox
# Pay Token and meters calls against the LemonCake sandbox gateway.
LEMONCAKE_SANDBOX_BASE=https://www.lemoncake.xyz
PORT=3000
PRICE_PER_CALL=0.05

# ── Production (env-only go-live) ─────────────────────────────────
# Set your Seller Key to charge for real — no code change. Create an
# endpoint + Seller Key in LemonCake /app (https://www.lemoncake.xyz/app):
# buyers prepay by card → agents call with a Pay Token → you keep 97%.
# LEMONCAKE_SELLER_KEY=sk_live_xxx

# Optional: a test Pay Token for `npm run smoke` (issue one in /app).
# LEMONCAKE_PAY_TOKEN=
