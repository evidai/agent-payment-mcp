{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "Node16",
    "moduleResolution":  "Node16",
    "esModuleInterop":   true,
    "strict":            true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "outDir":            "./dist",
    "rootDir":           "./src",
    "declaration":       false,
    "isolatedModules":   true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
