{
  "name": "@lemon-cake/mcp-sdk",
  "version": "1.0.0",
  "description": "Fiat usage-billing SDK for MCP/APIs. lc.charge() wraps MCP tools, lc.protect() wraps HTTP routes. Buyers pay by card, agents call with spend-capped Pay Tokens, no crypto. MIT-licensed open-core component of LemonCake.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lemoncake",
    "stripe",
    "payments",
    "ai-agent",
    "pay-per-call",
    "billing",
    "no-crypto"
  ],
  "homepage": "https://lemoncake.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidai/agent-payment-mcp.git"
  },
  "license": "MIT",
  "author": "LemonCake <contact@aievid.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "rm -rf dist && npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:basic": "tsx examples/basic.ts",
    "example:advanced": "tsx examples/advanced.ts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.10.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
